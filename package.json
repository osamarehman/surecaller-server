{
  "name": "surecaller-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SureCaller server: caller ID, spam reports and family alerts for Android clients.",
  "license": "AGPL-3.0-only",
  "repository": "github:osamarehman/surecaller-server",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
