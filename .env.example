# Copy to .env and fill in:  cp .env.example .env
# Never commit .env.

# --- Circle -------------------------------------------------------------
# Secret code the FIRST person types in the app to become admin. It also lets
# an existing admin re-register after a reinstall. Make it long and random,
# e.g. `openssl rand -hex 12`. The server refuses to start if it is shorter
# than 12 characters or still this example value.
ADMIN_CODE=change-me-to-something-long

# Encrypts shared contact names, name suggestions and the lookup log at rest: the database
# stores only keyed hashes of phone numbers and AES-GCM-sealed names. Generate once with
# `openssl rand -hex 32` (64 hex characters). The server refuses to start without it.
# Back it up with this file: if it is lost, every stored name is unreadable.
CONTACTS_KEY=

# Region used to read local numbers like 0300 1234567 (ISO country code).
DEFAULT_REGION=PK

# Distinct reporters (minus "not spam" votes) needed to label a number
# likely_scam. One report = suspected. Any admin report = likely_scam.
SPAM_THRESHOLD=2

# --- Network ------------------------------------------------------------
# Host port the API is published on (inside the container it is always 3000).
PORT=3000
# Interface to publish the plain-HTTP API port on. Default 127.0.0.1: only
# this server (Caddy / your own reverse proxy) can reach it. Set 0.0.0.0 only
# if you really want plain HTTP reachable from other machines.
BIND_ADDRESS=127.0.0.1

# Whether to believe X-Forwarded-For for the client IP (used by the per-IP
# register rate limit). Leave false unless a reverse proxy sits in front:
# then set 1 (one proxy hop, e.g. the built-in Caddy), or a comma-separated
# list of proxy IPs/CIDRs. Never enable it while the API port is publicly
# reachable, or clients can fake their IP. Prefer a hop count over `true`:
# `true` trusts every X-Forwarded-For hop, so any client can forge its IP.
# Cloudflare in front of the built-in Caddy is 2 hops: TRUST_PROXY=2.
TRUST_PROXY=false

# Public base URL of this server, used to build the APK download link in
# /v1/app/latest. Required for app updates: without it that route answers 503.
# Example: https://calls.example.com
PUBLIC_URL=

# Domain for the optional Caddy HTTPS proxy (`--profile https`). Point an A
# record at this server first. Example: calls.example.com
DOMAIN=

# --- Database -----------------------------------------------------------
# docker-compose builds DATABASE_URL from these for you. Use only letters and
# digits in the password (e.g. `openssl rand -hex 16`) so the URL stays valid.
POSTGRES_USER=surecaller
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=surecaller
# Only set this when running the API outside docker-compose:
# DATABASE_URL=postgres://surecaller:password@localhost:5432/surecaller

# --- Push notifications (optional) --------------------------------------
# Path INSIDE the container to a Firebase service-account JSON. Put the file in
# ./secrets/ next to docker-compose.yml. Leave empty to disable push; the app
# still gets alerts by polling.
# FCM_SERVICE_ACCOUNT=/app/secrets/fcm-service-account.json
FCM_SERVICE_ACCOUNT=

# --- Tuning (optional) --------------------------------------------------
# Single lookups allowed per member per minute (anti-scraping).
LOOKUP_RATE_LIMIT=120
# Numbers per member per minute across batch lookups (Recents labelling).
# Each distinct number in a batch counts as one.
BATCH_LOOKUP_RATE_LIMIT=300
# Registration attempts per IP per minute (slows invite-code guessing).
REGISTER_RATE_LIMIT=10
# Email code requests per IP per hour (POST /v1/email-codes).
EMAIL_CODE_RATE_LIMIT=5
# fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Telemetry (phone logs and crash reports) ---------------------------
# Reports per client IP per minute (POST /v1/telemetry; works without sign-in).
# Without TRUST_PROXY behind a proxy, every phone shares the proxy's IP and this
# one budget, so keep it roomy.
TELEMETRY_RATE_LIMIT=120
# Events one phone may store per 24 hours; the excess is dropped, not rejected.
TELEMETRY_MAX_EVENTS_PER_INSTALL_DAY=5000
# Safety caps on the telemetry table: on-disk size in bytes (exact, default
# 500 MB) and approximate row count. Above either, new reports are dropped
# until old rows are pruned.
TELEMETRY_MAX_BYTES=524288000
TELEMETRY_MAX_ROWS=2000000
# Days to keep phone logs before they are deleted.
TELEMETRY_RETENTION_DAYS=14
# Phones that should also send verbose `debug` events: comma-separated install
# ids (see `node dist/cli/logs.js --installs`), or `all`. Empty = none.
# Run `docker compose up -d` after changing it.
TELEMETRY_DEBUG_INSTALLS=

# --- Email (sign-up codes, optional) -------------------------------------
# SMTP server for the 6-digit email codes, e.g. smtps://user:pass@mail.example.com:465
# (URL-encode the password). Empty = no email.
SMTP_URL=
MAIL_FROM=SureCaller <noreply@example.com>
# OAuth web client ID(s) for "Sign in with Google", comma-separated. Empty = email codes only.
GOOGLE_CLIENT_IDS=
# `required`: every new account must verify an email (by code or Google). Anything else: email is optional.
EMAIL_VERIFICATION=off
